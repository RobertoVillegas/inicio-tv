<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="320dp"
    android:height="180dp">
    <item>
        <shape>
            <gradient
                android:angle="270"
                android:endColor="#2E4A3A"
                android:startColor="#8DB3C7" />
        </shape>
    </item>
    <item
        android:bottom="40dp"
        android:left="70dp"
        android:right="70dp"
        android:top="70dp">
        <shape android:shape="rectangle">
            <solid android:color="#E6FFFFFF" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</layer-list>
